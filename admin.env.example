# Nomes das chaves de /srv/dev/secrets/admin.env (600, dono dev). So o dev le. Valores nunca entram no Git.
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COMPOSIO_API_KEY=
SERPAPI_API_KEY=
FEATHERLESS_API_KEY=
# backup — as tres tambem ficam no gerenciador de senhas: sem elas nao ha restore
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
# Hostinger (snapshot, metricas, reinicio): token da API e id da VM; bin/hostinger.sh
HOSTINGER_API_TOKEN=
HOSTINGER_VM_ID=
# PMO (34-pmo.sh aborta sem PMO_HOSTS, PMO_LOGINS e GITHUB_TOKEN)
# hosts aceitos no cabecalho Host, COM a porta, separados por virgula; o primeiro vira a URL do resumo semanal
PMO_HOSTS=stack.<tailnet>.ts.net:8443,localhost:8080
# login(s) da tailnet autorizados a agir pelo painel (cabecalho Tailscale-User-Login), separados por virgula
PMO_LOGINS=<login-tailscale-do-dono>
# opcional: atalho "Abrir OpenCode" no painel (so https)
PMO_ATALHO_OPENCODE=https://stack.<tailnet>.ts.net/
# espelho do Linear (opcional; sem as duas o 34 pula o espelho): chave pessoal da API e chave do time (ex.: ABC)
LINEAR_API_KEY=
LINEAR_TEAM_KEY=
# alertas (canal sem valor e pulado)
NTFY_TOPIC=
RESEND_API_KEY=
ALERTA_DE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
