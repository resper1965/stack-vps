#!/bin/sh
# Credencial do GitHub para o agente, lida na hora: GITHUB_TOKEN do ambiente (o .envrc do projeto
# pode trocar pelo token do dono certo) ou o do agente.env. O token nunca vai para .gitconfig.
[ "$1" = get ] || exit 0
t=${GITHUB_TOKEN:-$(. /srv/dev/secrets/agente.env 2>/dev/null; printf '%s' "$GITHUB_TOKEN")}
[ -n "$t" ] && printf 'username=x-access-token\npassword=%s\n' "$t"
exit 0
