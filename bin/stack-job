#!/usr/bin/env bash
# Executa um job agendado (jobs/<nome>.job) como agente: clone raso do REPO (token somente leitura pelo
# git-credential-stack), segredos de /srv/dev/secrets/jobs/<arquivo>.env so no ambiente do comando, timeout,
# resultado em /srv/dev/state/jobs/<nome>.json e .log. Valor de segredo nunca vai a saida, log, json nem argv:
# toda saida do comando passa por um filtro que troca os valores carregados por ***. rc != 0 chama o alertar.sh.
# Uso: stack-job <nome>
# Sobrescreviveis nos testes (so com STACK_TESTE=1): JOBS_DIR STATE_DIR WORK_DIR SECRETS_DIR ALERTAR CLONE_CMD
# JOB_TIMEOUT_UNIT (m|s) JOB_SECRETS_DONO.
set -uo pipefail
set -f   # COMANDO aceita '*' (nao e glob aqui)
umask 027

nome=${1:-}
[[ $nome =~ ^[a-z0-9-]+$ ]] || { echo "uso: stack-job <nome> (nome em [a-z0-9-]+)" >&2; exit 2; }
REPO_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

# >>> normaliza
if [[ ${STACK_TESTE:-} != 1 ]]; then
  JOBS_DIR=$REPO_DIR/jobs; STATE_DIR=/srv/dev/state/jobs; WORK_DIR=/srv/dev/jobs/work; SECRETS_DIR=/srv/dev/secrets/jobs
  ALERTAR=/usr/local/lib/stack-vps/alertar.sh; CLONE_CMD=; JOB_TIMEOUT_UNIT=m; JOB_SECRETS_DONO=dev
fi
# <<< normaliza
JOBS_DIR=${JOBS_DIR:-$REPO_DIR/jobs}; STATE_DIR=${STATE_DIR:-/srv/dev/state/jobs}; WORK_DIR=${WORK_DIR:-/srv/dev/jobs/work}
SECRETS_DIR=${SECRETS_DIR:-/srv/dev/secrets/jobs}; ALERTAR=${ALERTAR:-/usr/local/lib/stack-vps/alertar.sh}
CLONE_CMD=${CLONE_CMD:-}; JOB_TIMEOUT_UNIT=${JOB_TIMEOUT_UNIT:-m}; JOB_SECRETS_DONO=${JOB_SECRETS_DONO:-dev}

# shellcheck source=scripts/lib/job-parse.sh
. "$REPO_DIR/scripts/lib/job-parse.sh"
job_carregar "$JOBS_DIR/$nome.job" || exit 2

mkdir -p "$STATE_DIR" || { echo "stack-job: nao criei $STATE_DIR" >&2; exit 1; }
LOG=$STATE_DIR/$nome.log; JSON=$STATE_DIR/$nome.json
tmp=$(mktemp -d) || exit 1
chmod 700 "$tmp"
W=$WORK_DIR/$nome
trap 'rm -rf "$tmp" "$W"' EXIT
: > "$tmp/segredos"
SK=(); SV=(); erro=

# CHAVE=VALOR linha a linha, sem source. Mensagens citam so o numero da linha, nunca o conteudo.
carrega_segredos() {
  [[ -n $J_SEGREDOS ]] || return 0
  local f=$SECRETS_DIR/$J_SEGREDOS.env linha k v mode dono n=0
  [[ -f $f && ! -L $f ]] || { erro="segredos: $J_SEGREDOS.env ausente ou nao e arquivo regular"; return 1; }
  read -r mode dono < <(stat -c '%a %U' -- "$f") || { erro="segredos: stat falhou"; return 1; }
  (( (8#$mode & ~8#640) == 0 )) || { erro="segredos: $J_SEGREDOS.env com modo largo (use 0640)"; return 1; }
  [[ $dono == "$JOB_SECRETS_DONO" ]] || { erro="segredos: $J_SEGREDOS.env com dono errado (esperado $JOB_SECRETS_DONO)"; return 1; }
  while IFS= read -r linha || [[ -n $linha ]]; do
    n=$((n+1)); linha=${linha%$'\r'}
    [[ $linha =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ $linha =~ ^(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || { erro="segredos: linha $n malformada"; return 1; }
    k=${BASH_REMATCH[2]} v=${BASH_REMATCH[3]}
    [[ $k =~ ^(PATH|IFS|HOME|SHELL|ENV|BASH_ENV|LD_.*|PYTHON.*)$ ]] && { erro="segredos: chave $k proibida (linha $n)"; return 1; }
    if (( ${#v} >= 2 )) && [[ ${v:0:1} == [\'\"] && ${v: -1} == "${v:0:1}" ]]; then v=${v:1:${#v}-2}; fi
    SK+=("$k"); SV+=("$v")
    [[ -z $v ]] || printf '%s\n' "$v" >> "$tmp/segredos"
  done < "$f"
}
carrega_segredos || true

clona() { # <dono/repo> <destino>
  if [[ -n $CLONE_CMD ]]; then
    # shellcheck disable=SC2086  # comando de teste, word splitting intencional
    $CLONE_CMD "$1" "$2"
  else
    GIT_TERMINAL_PROMPT=0 git -c credential.helper= -c "credential.helper=$REPO_DIR/bin/git-credential-stack" \
      clone --depth 1 -q "https://github.com/$1.git" "$2"
  fi
}

executa() {
  local palavras i
  echo 1 > "$tmp/rc"
  [[ -z $erro ]] || { echo "$erro"; return; }
  rm -rf "$W"; mkdir -p "$WORK_DIR" || { echo "nao criei $WORK_DIR"; return; }
  if [[ -n $J_REPO ]]; then clona "$J_REPO" "$W" 2>&1 || { echo "clone de $J_REPO falhou"; return; }
  else mkdir -p "$W"; fi
  cd "$W" || { echo "sem $W"; return; }
  read -ra palavras <<<"$J_COMANDO"; palavras[0]=$J_BASE/${palavras[0]}
  ( for i in "${!SK[@]}"; do export "${SK[i]}=${SV[i]}"; done
    exec timeout -k 10s "${J_TIMEOUT_MIN}${JOB_TIMEOUT_UNIT}" "${palavras[@]}" ) </dev/null
  echo $? > "$tmp/rc"
}

# filtro: troca cada valor de segredo por *** (maiores primeiro) e guarda so o ultimo 1 MiB
# ponytail: le tudo em memoria; o timeout do job limita o volume
filtro='
import sys
vs = sorted({l for l in open(sys.argv[1], "rb").read().split(b"\n") if l}, key=len, reverse=True)
d = sys.stdin.buffer.read()
for v in vs: d = d.replace(v, b"***")
sys.stdout.buffer.write(d[-1048576:])
'
inicio=$(date +%s)
executa 2>&1 | python3 -I -c "$filtro" "$tmp/segredos" > "$LOG"
fim=$(date +%s)
rc=$(cat "$tmp/rc" 2>/dev/null); [[ $rc =~ ^[0-9]+$ ]] || rc=1

# o resumo sai do log ja filtrado (arquivo, nunca argv); o python grava o json de forma atomica
python3 -I -c '
import json, os, re, sys
log, saida, ini, fim, rc = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), int(sys.argv[5])
linhas = [l for l in open(log, "rb").read().decode("utf-8", "replace").splitlines() if l.strip()][-3:]
resumo = re.sub(r"[\x00-\x1f\x7f]", "", " | ".join(linhas))[:300]
tmp = saida + ".novo"
with open(tmp, "w") as f: json.dump({"inicio": ini, "fim": fim, "rc": rc, "resumo": resumo}, f)
os.replace(tmp, saida)
' "$LOG" "$JSON" "$inicio" "$fim" "$rc" || echo "stack-job: nao gravei $JSON" >&2

echo "stack-job: $nome rc=$rc"
if (( rc != 0 )); then "$ALERTAR" "job falhou" "$nome rc=$rc" >/dev/null 2>&1 || echo "stack-job: alerta nao entregue"; fi
exit $(( rc > 255 ? 1 : rc ))
